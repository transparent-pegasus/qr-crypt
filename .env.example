VITE_APP_NAME=Qrypt
VITE_APP_SHORT_NAME=Qrypt
VITE_DEFAULT_ALGORITHM=A256GCM
VITE_QR_ERROR_CORRECTION=Q
VITE_QR_RENDER_SIZE=512
VITE_MAX_PLAINTEXT_BYTES=4096
VITE_ENABLE_RSA=true
VITE_ENABLE_ECDH=false
VITE_ENABLE_PRIVATE_KEY_EXPORT=false
VITE_AUTO_CLEAR_SECONDS=300
VITE_BUILD_SHA=development

# --- v2 ポスト量子(spec2 §15。既定方式の MLKEM768_A256GCM 化は WP-14 で反転)---
VITE_DEFAULT_PQ_PROFILE=balanced
VITE_ENABLE_ML_KEM=true
VITE_ENABLE_ML_DSA=true
VITE_ENABLE_MAXIMUM_PQ=false
VITE_REQUIRE_SIGNATURE=false
VITE_QR_FRAME_BYTES=600
VITE_QR_FRAME_INTERVAL_MS=450
VITE_QR_MAX_FRAMES=64
VITE_PQ_PROVIDER=noble
VITE_PQ_WORKER_ENABLED=true
VITE_ENABLE_ENCRYPTED_SEED_BACKUP=false
