VITE_APP_NAME="QR Crypt"
VITE_APP_SHORT_NAME="QR Crypt"
VITE_DEFAULT_ALGORITHM=A256GCM
VITE_QR_RENDER_SIZE=1024
VITE_MAX_PLAINTEXT_BYTES=120000
VITE_AUTO_CLEAR_SECONDS=60
VITE_AUTO_CLEAR_FALLBACK_SECONDS=300
VITE_BUILD_SHA=development

# --- v2 post-quantum settings ---
VITE_ENABLE_ML_KEM=true
VITE_ENABLE_ML_DSA=true
VITE_QR_FRAME_BYTES=1000
VITE_QR_FRAME_INTERVAL_MS=200
VITE_QR_MAX_FRAMES=128
VITE_PQ_PROVIDER=noble
VITE_PQ_WORKER_ENABLED=true
